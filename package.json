{
  "name": "school-management-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "jwt:secret": "tsx src/utils/generate-jwt-secret.ts",
    "db:push": "npx prisma db execute --file prisma/pre-push.sql && npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:seed": "npx prisma db seed",
    "db:seed:students": "tsx src/utils/seed-students.ts",
    "gazetteer:download": "tsx src/utils/download-gazetteer.ts",
    "db:seed:gazetteer": "tsx src/utils/seed-gazetteer.ts",
    "db:classes:full-day": "tsx src/utils/convert-classes-full-day.ts",
    "db:seed:staff": "tsx src/utils/seed-staff.ts",
    "db:seed:demo": "tsx src/utils/seed-demo.ts",
    "db:reset:demo": "tsx src/utils/seed-demo.ts --reset",
    "demo:install": "tsx src/utils/demo-install.ts",
    "demo:install:lower": "tsx src/utils/demo-install.ts --level lower",
    "demo:install:upper": "tsx src/utils/demo-install.ts --level upper",
    "demo:install:combined": "tsx src/utils/demo-install.ts --level combined",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "db:seed:holidays": "tsx src/utils/seed-holidays.ts",
    "demo:announcements:generate": "tsx src/utils/generate-announcements.ts",
    "db:seed:announcements": "tsx src/utils/seed-announcements.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@fontsource/battambang": "5.3.0",
    "@fontsource/moul": "5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "7.2.1",
    "prisma": "^7.10.1",
    "supertest": "7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
