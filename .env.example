# Copy to .env and fill in the required values:  cp .env.example .env
# The API checks these at startup and refuses to start if a required value is missing or invalid.

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string. The API connects at startup and exits if it can't.
# With Docker Compose this is built from the POSTGRES_* values below, so you can leave it as is.
DATABASE_URL=postgresql://school:school@localhost:5432/school_management

# Secret used to sign access tokens: at least 32 characters, random. Generate and write it into .env with:
#   npm run jwt:secret          (or print one with: openssl rand -base64 48)
# Changing it logs everyone out.
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48

# Frontend address(es) allowed to call the API from a browser, comma-separated.
# Scheme + host + optional port only, no path, e.g. https://school.example.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Server ──────────────────────────────────────────────────────────────────

# Port the API listens on (default 3000)
PORT=3000

# Access token lifetime: a number with a unit, e.g. 30m, 8h, 7d (default 8h)
JWT_EXPIRES_IN=8h

# Set to "production" in production: the demo scripts then refuse to run
# NODE_ENV=production

# ── Login protection ────────────────────────────────────────────────────────

# Failed logins in a row before a username is locked (default 5)
LOGIN_MAX_FAILURES=5
# How long a locked username stays locked, in minutes (default 15)
LOGIN_LOCK_MINUTES=15
# Failed logins from one IP address before that IP is blocked (default 30)
LOGIN_IP_MAX_FAILURES=30
# Window for LOGIN_IP_MAX_FAILURES, in minutes (default 15)
LOGIN_IP_WINDOW_MINUTES=15

# ── School (used on first install only; afterwards change them via /school-settings) ──

# LOWER_SECONDARY (grades 7–9), UPPER_SECONDARY (grades 10–12) or COMBINED (grades 7–12). Default COMBINED.
SCHOOL_LEVEL=COMBINED
# School name in Khmer script and in Latin script (optional)
SCHOOL_KHMER_NAME=
SCHOOL_LATIN_NAME=

# ── Seeding (npm run db:seed) ───────────────────────────────────────────────

# Root admin created by the seed. They must change the password on first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123!

# Password for every demo account created by npm run db:seed:demo / demo:install (default Demo@1234)
DEMO_PASSWORD=Demo@1234

# ── Docker Compose only ─────────────────────────────────────────────────────

# PostgreSQL credentials for the db container (defaults shown)
POSTGRES_USER=school
POSTGRES_PASSWORD=school
POSTGRES_DB=school_management
# Host port the API is published on (default 3000)
API_PORT=3000

# Nightly database backups (the backup service). BACKUP_DIR is a folder on the host: put it on a
# DIFFERENT disk than Docker's data (second drive, USB disk or mounted NAS), e.g. /mnt/backup-disk/school.
# Backups on the same disk are lost together with the database if that disk fails.
BACKUP_DIR=./backups
# Time of the daily backup, 24-hour HH:MM in TZ (default 02:00)
BACKUP_TIME=02:00
# How many days of backups to keep (default 14)
BACKUP_KEEP_DAYS=14
# Timezone for BACKUP_TIME and backup file names (default Asia/Phnom_Penh)
TZ=Asia/Phnom_Penh
