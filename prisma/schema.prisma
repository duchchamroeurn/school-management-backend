// prisma/schema.prisma
//
// Conventions:
// - Single-tenant: one database = one school, so no schoolId columns.
// - Auth (users) is kept separate from human records (staff_profiles, student_profiles).
// - RBAC uses explicit junction tables (role_permissions, user_roles).
// - Every human-facing name has khmerName (Khmer Unicode) + latinName.
// - Tables/columns are snake_case in PostgreSQL via @@map / @map.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Connection URL lives in prisma7.config.ts (Prisma 7 no longer allows `url` here)
datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ENUMS (Constants)
// ==========================================

enum Gender {
  M // ប្រុស (Male)
  F // ស្រី (Female)
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EducationLevel {
  LOWER_SECONDARY // Grades 7, 8, 9
  UPPER_SECONDARY // Grades 10, 11, 12
}

// Which grades this installation offers
enum SchoolLevel {
  LOWER_SECONDARY // អនុវិទ្យាល័យ: grades 7–9
  UPPER_SECONDARY // វិទ្យាល័យ (high school only): grades 10–12
  COMBINED // វិទ្យាល័យ with lower section: grades 7–12
}

enum StudentStatus {
  ENROLLED
  GRADUATED
  DROPPED_OUT
}

enum EnrollmentType {
  NEW_ADMISSION
  PROMOTED
  REPEATING
}

enum AcademicYearStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

// ==========================================
// SCHOOL SETTINGS (single row, id = 1)
// ==========================================

model SchoolSettings {
  id        Int         @id @default(1) // always 1 — one school per installation
  level     SchoolLevel @default(COMBINED)
  khmerName String?     @map("khmer_name") // e.g. 'វិទ្យាល័យព្រះស៊ីសុវត្ថិ'
  latinName String?     @map("latin_name") // e.g. 'Preah Sisowath High School'
  moeysCode String?     @map("moeys_code") // school code issued by MoEYS
  address   String?
  phone     String?
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("school_settings")
}

// ==========================================
// 2. AUTH & RBAC (Dynamic Permissions)
// ==========================================

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")

  // Forces a password change before any other action (set for seeded/admin-created accounts)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  // Tokens issued before this moment are rejected
  passwordChangedAt  DateTime? @map("password_changed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations (a login belongs to at most one staff OR one student profile)
  staffProfile   StaffProfile?
  studentProfile StudentProfile?
  userRoles      UserRole[]

  @@map("users")
}

model Role {
  id              String  @id @default(uuid())
  khmerName       String  @map("khmer_name") // e.g., 'រដ្ឋបាល'
  latinName       String  @unique @map("latin_name") // e.g., 'Registrar'
  isSystemDefault Boolean @default(false) @map("is_system_default")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  module      String // e.g., 'STUDENT_INTAKE', 'ACADEMIC'
  code        String @unique // e.g., 'CREATE_STUDENT'
  description String

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ==========================================
// 3. PROFILES (People)
// ==========================================

model StaffProfile {
  id             String   @id @default(uuid())
  // National ID card number (លេខអត្តសញ្ញាណប័ណ្ណ), normalised: Khmer digits → 0-9, upper-case. Prevents duplicate staff.
  nationalIdNo   String   @unique @map("national_id_no")
  khmerName      String   @map("khmer_name")
  latinName      String   @map("latin_name")
  gender         Gender
  phone          String?
  telegramHandle String?  @map("telegram_handle")
  hireDate       DateTime @map("hire_date")

  // Link to Auth User (1-to-1). If user is deleted, profile remains.
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  homeroomClasses ClassSection[] @relation("HomeroomTeacher")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("staff_profiles")
}

model StudentProfile {
  id                  String        @id @default(uuid())
  studentIdentifier   String        @unique @map("student_identifier") // e.g., STU-26-0001
  // Birth certificate number (លេខសំបុត្រកំណើត), normalised: Khmer digits → 0-9, upper-case. Prevents double registration.
  birthCertificateNo  String        @unique @map("birth_certificate_no")
  khmerName           String        @map("khmer_name")
  latinName           String        @map("latin_name")
  dateOfBirth         DateTime      @map("date_of_birth") @db.Date
  gender              Gender
  primarySchoolOrigin String?       @map("primary_school_origin") // e.g., "Riverside Primary"
  status              StudentStatus @default(ENROLLED)

  // Optional link to Auth User (1-to-1) so the student can sign in. If user is deleted, profile remains.
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  enrollments YearlyEnrollment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("student_profiles")
}

// ==========================================
// 4. ACADEMIC INFRASTRUCTURE
// ==========================================

model AcademicYear {
  id        String             @id @default(uuid())
  name      String             @unique // e.g., "2026-2027"
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    AcademicYearStatus @default(UPCOMING)

  // Relations
  classes     ClassSection[]
  enrollments YearlyEnrollment[]

  @@map("academic_years")
}

model Grade {
  id          String         @id @default(uuid())
  level       EducationLevel
  gradeNumber Int            @unique @map("grade_number") // 7, 8, 9, 10, 11, 12

  // Relations
  classes       ClassSection[]
  gradeSubjects GradeSubject[]

  @@map("grades")
}

model Subject {
  id            String  @id @default(uuid())
  code          String  @unique // e.g., 'MATH'
  khmerName     String  @map("khmer_name") // e.g., 'គណិតវិទ្យា'
  latinName     String  @map("latin_name") // e.g., 'Mathematics'
  isCoreSubject Boolean @default(true) @map("is_core_subject") // True = failing this means failing the year

  // Relations
  gradeSubjects GradeSubject[]

  @@map("subjects")
}

model GradeSubject {
  gradeId   String @map("grade_id")
  subjectId String @map("subject_id")

  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([gradeId, subjectId])
  @@index([subjectId])
  @@map("grade_subjects")
}

model ClassSection {
  id          String @id @default(uuid())
  sectionName String @map("section_name") // e.g., "A", "B", "C"
  maxCapacity Int    @map("max_capacity")

  // Foreign Keys
  gradeId           String  @map("grade_id")
  academicYearId    String  @map("academic_year_id")
  homeroomTeacherId String? @map("homeroom_teacher_id")

  // Relations
  grade           Grade              @relation(fields: [gradeId], references: [id])
  academicYear    AcademicYear       @relation(fields: [academicYearId], references: [id])
  homeroomTeacher StaffProfile?      @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  enrollments     YearlyEnrollment[]

  // A class section is unique per academic year (e.g., you can't have two 7A's in 2026)
  @@unique([gradeId, sectionName, academicYearId])
  // A teacher is homeroom teacher of at most one class per academic year (NULLs don't conflict)
  @@unique([homeroomTeacherId, academicYearId])
  @@map("class_sections")
}

// ==========================================
// 5. ENROLLMENTS & OPERATIONS
// ==========================================

model YearlyEnrollment {
  id             String         @id @default(uuid())
  enrollmentType EnrollmentType @map("enrollment_type")
  enrollmentDate DateTime       @default(now()) @map("enrollment_date")

  // Foreign Keys
  studentId      String @map("student_id")
  classSectionId String @map("class_section_id")
  academicYearId String @map("academic_year_id")

  // Relations
  student      StudentProfile @relation(fields: [studentId], references: [id])
  classSection ClassSection   @relation(fields: [classSectionId], references: [id])
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])

  // A student can only be enrolled in one class per academic year
  @@unique([studentId, academicYearId])
  @@index([classSectionId])
  @@map("yearly_enrollments")
}
