// prisma/schema.prisma
//
// Conventions:
// - Single-tenant: one database = one school, so no schoolId columns.
// - Auth (users) is kept separate from human records (staff_profiles, student_profiles).
// - RBAC uses explicit junction tables (role_permissions, user_roles).
// - Every human-facing name has khmerName (Khmer Unicode) + latinName.
// - Tables/columns are snake_case in PostgreSQL via @@map / @map.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Connection URL lives in prisma7.config.ts (Prisma 7 no longer allows `url` here)
datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. ENUMS (Constants)
// ==========================================

enum Gender {
  M // ប្រុស (Male)
  F // ស្រី (Female)
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EducationLevel {
  LOWER_SECONDARY // Grades 7, 8, 9
  UPPER_SECONDARY // Grades 10, 11, 12
}

// Which grades this installation offers
enum SchoolLevel {
  LOWER_SECONDARY // អនុវិទ្យាល័យ: grades 7–9
  UPPER_SECONDARY // វិទ្យាល័យ (high school only): grades 10–12
  COMBINED // វិទ្យាល័យ with lower section: grades 7–12
}

enum StudentStatus {
  ENROLLED
  GRADUATED
  DROPPED_OUT
}

enum EnrollmentType {
  NEW_ADMISSION
  PROMOTED
  REPEATING
}

// MoEYS mention (និទ្ទេស) for a period's result
enum Mention {
  A // ល្អប្រសើរ (Excellent)
  B // ល្អណាស់ (Very good)
  C // ល្អ (Good)
  D // ល្អបង្គួរ (Fairly good)
  E // មធ្យម (Average)
  F // ខ្សោយ (Weak / fail)
}

enum AcademicYearStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

// ==========================================
// SCHOOL SETTINGS (single row, id = 1)
// ==========================================

model SchoolSettings {
  id        Int         @id @default(1) // always 1 — one school per installation
  level     SchoolLevel @default(COMBINED)
  khmerName String?     @map("khmer_name") // e.g. 'វិទ្យាល័យព្រះស៊ីសុវត្ថិ'
  latinName String?     @map("latin_name") // e.g. 'Preah Sisowath High School'
  moeysCode String?     @map("moeys_code") // school code issued by MoEYS
  address   String?
  phone     String?
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("school_settings")
}

// ==========================================
// 2. AUTH & RBAC (Dynamic Permissions)
// ==========================================

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")

  // Forces a password change before any other action (set for seeded/admin-created accounts)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  // Tokens issued before this moment are rejected
  passwordChangedAt  DateTime? @map("password_changed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations (a login belongs to at most one staff OR one student profile)
  staffProfile   StaffProfile?
  studentProfile StudentProfile?
  userRoles      UserRole[]

  @@map("users")
}

model Role {
  id              String  @id @default(uuid())
  khmerName       String  @map("khmer_name") // e.g., 'រដ្ឋបាល'
  latinName       String  @unique @map("latin_name") // e.g., 'Registrar'
  isSystemDefault Boolean @default(false) @map("is_system_default")

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  module      String // e.g., 'STUDENT_INTAKE', 'ACADEMIC'
  code        String @unique // e.g., 'CREATE_STUDENT'
  description String

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ==========================================
// 3. PROFILES (People)
// ==========================================

model StaffProfile {
  id             String   @id @default(uuid())
  // National ID card number (លេខអត្តសញ្ញាណប័ណ្ណ), normalised: Khmer digits → 0-9, upper-case. Prevents duplicate staff.
  nationalIdNo   String   @unique @map("national_id_no")
  khmerName      String   @map("khmer_name")
  latinName      String   @map("latin_name")
  gender         Gender
  phone          String?
  telegramHandle String?  @map("telegram_handle")
  hireDate       DateTime @map("hire_date") @db.Date

  // Link to Auth User (1-to-1). If user is deleted, profile remains.
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  homeroomClasses     ClassSection[]       @relation("HomeroomTeacher")
  teachingAssignments TeachingAssignment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("staff_profiles")
}

model StudentProfile {
  id                  String        @id @default(uuid())
  studentIdentifier   String        @unique @map("student_identifier") // e.g., STU-26-0001
  // Birth certificate number (លេខសំបុត្រកំណើត), normalised: Khmer digits → 0-9, upper-case. Prevents double registration.
  birthCertificateNo  String        @unique @map("birth_certificate_no")
  khmerName           String        @map("khmer_name")
  latinName           String        @map("latin_name")
  dateOfBirth         DateTime      @map("date_of_birth") @db.Date
  gender              Gender
  primarySchoolOrigin String?       @map("primary_school_origin") // e.g., "Riverside Primary"
  status              StudentStatus @default(ENROLLED)

  // Optional link to Auth User (1-to-1) so the student can sign in. If user is deleted, profile remains.
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Relations
  enrollments YearlyEnrollment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("student_profiles")
}

// ==========================================
// 4. ACADEMIC INFRASTRUCTURE
// ==========================================

model AcademicYear {
  id        String             @id @default(uuid())
  name      String             @unique // e.g., "2026-2027"
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    AcademicYearStatus @default(UPCOMING)

  // Relations
  classes           ClassSection[]
  enrollments       YearlyEnrollment[]
  assessmentPeriods AssessmentPeriod[]

  @@map("academic_years")
}

model Grade {
  id          String         @id @default(uuid())
  level       EducationLevel
  gradeNumber Int            @unique @map("grade_number") // 7, 8, 9, 10, 11, 12

  // Relations
  classes       ClassSection[]
  gradeSubjects GradeSubject[]

  @@map("grades")
}

model Subject {
  id            String  @id @default(uuid())
  code          String  @unique // e.g., 'MATH'
  khmerName     String  @map("khmer_name") // e.g., 'គណិតវិទ្យា'
  latinName     String  @map("latin_name") // e.g., 'Mathematics'
  isCoreSubject Boolean @default(true) @map("is_core_subject") // True = failing this means failing the year

  // Relations
  gradeSubjects       GradeSubject[]
  // Scoring rules live per assessment period, not on the subject (see SubjectAssessmentConfig)
  assessmentConfigs   SubjectAssessmentConfig[]
  teachingAssignments TeachingAssignment[]

  @@map("subjects")
}

model GradeSubject {
  gradeId   String @map("grade_id")
  subjectId String @map("subject_id")

  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([gradeId, subjectId])
  @@index([subjectId])
  @@map("grade_subjects")
}

model ClassSection {
  id          String @id @default(uuid())
  sectionName String @map("section_name") // e.g., "A", "B", "C"
  maxCapacity Int    @map("max_capacity")

  // Foreign Keys
  gradeId           String  @map("grade_id")
  academicYearId    String  @map("academic_year_id")
  homeroomTeacherId String? @map("homeroom_teacher_id")

  // Relations
  grade               Grade                @relation(fields: [gradeId], references: [id])
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id])
  homeroomTeacher     StaffProfile?        @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  enrollments         YearlyEnrollment[]
  teachingAssignments TeachingAssignment[]

  // A class section is unique per academic year (e.g., you can't have two 7A's in 2026)
  @@unique([gradeId, sectionName, academicYearId])
  // A teacher is homeroom teacher of at most one class per academic year (NULLs don't conflict)
  @@unique([homeroomTeacherId, academicYearId])
  @@map("class_sections")
}

// Who teaches which subject in which class (the class fixes grade and academic year). A teacher can
// teach several subjects and classes; each subject in a class has exactly one teacher. Score entry
// checks this: a teacher may only enter scores for their own subject in their own classes.
model TeachingAssignment {
  id             String @id @default(uuid())
  staffId        String @map("staff_id")
  subjectId      String @map("subject_id")
  classSectionId String @map("class_section_id")

  // Relations
  staff        StaffProfile @relation(fields: [staffId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([subjectId, classSectionId])
  @@index([staffId])
  @@index([classSectionId])
  @@map("teaching_assignments")
}

// ==========================================
// 5. ENROLLMENTS & OPERATIONS
// ==========================================

model YearlyEnrollment {
  id             String         @id @default(uuid())
  enrollmentType EnrollmentType @map("enrollment_type")
  enrollmentDate DateTime       @default(now()) @map("enrollment_date")

  // Foreign Keys
  studentId      String @map("student_id")
  classSectionId String @map("class_section_id")
  academicYearId String @map("academic_year_id")

  // Relations
  student      StudentProfile @relation(fields: [studentId], references: [id])
  classSection ClassSection   @relation(fields: [classSectionId], references: [id])
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])

  // Scores belong to the enrollment (student + class + year), so rankings use the class the student was in
  componentScores      ComponentScore[]
  monthlySubjectScores MonthlySubjectScore[]
  monthlyResults       MonthlyResult[]

  // A student can only be enrolled in one class per academic year
  @@unique([studentId, academicYearId])
  @@index([classSectionId])
  @@map("yearly_enrollments")
}

// ==========================================
// 6. ASSESSMENT & GRADING (MoEYS)
// ==========================================
//
// Scoring rules change per period: Math in January may be out of 50 with no components, while
// Math in February is out of 100 split into components. So the rules hang off
// SubjectAssessmentConfig (subject × period), never off Subject.
//
//   AssessmentPeriod ─┬─ SubjectAssessmentConfig ── SubjectComponent ── ComponentScore
//                     │          └──────────────── MonthlySubjectScore
//                     └─ MonthlyResult
//
// Scores reference the YearlyEnrollment. Deleting a period, config or component that already has
// scores is refused (Restrict), so recorded scores are never removed by a cascade.

// A month ("January") or exam period ("Semester 1") within an academic year
model AssessmentPeriod {
  id             String  @id @default(uuid())
  name           String // e.g. "January", "Semester 1"
  academicYearId String  @map("academic_year_id")
  // Locked = results are final: scores and configs for this period may no longer change
  isLocked       Boolean @default(false) @map("is_locked")

  // Relations
  academicYear   AcademicYear              @relation(fields: [academicYearId], references: [id])
  subjectConfigs SubjectAssessmentConfig[]
  results        MonthlyResult[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([academicYearId, name])
  @@map("assessment_periods")
}

// How one subject is scored in one period. Validate with assertConfigComponentsValid (src/utils/assessment.ts):
// when isComponentBased, the components' maxScore values must add up to exactly maxTotalScore.
model SubjectAssessmentConfig {
  id                 String  @id @default(uuid())
  subjectId          String  @map("subject_id")
  assessmentPeriodId String  @map("assessment_period_id")
  maxTotalScore      Float   @map("max_total_score") // e.g. 50 or 100
  // true = the total is the sum of SubjectComponent scores; false = one score is entered directly
  isComponentBased   Boolean @default(false) @map("is_component_based")

  // Relations
  subject          Subject               @relation(fields: [subjectId], references: [id])
  assessmentPeriod AssessmentPeriod      @relation(fields: [assessmentPeriodId], references: [id], onDelete: Cascade)
  components       SubjectComponent[]
  subjectScores    MonthlySubjectScore[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([subjectId, assessmentPeriodId])
  @@index([assessmentPeriodId])
  @@map("subject_assessment_configs")
}

// A scored part of a subject in one period, e.g. "Homework" / 20, "Exam" / 80
model SubjectComponent {
  id                        String @id @default(uuid())
  subjectAssessmentConfigId String @map("subject_assessment_config_id")
  name                      String // e.g. "Homework", "Oral", "Exam"
  maxScore                  Float  @map("max_score")

  // Relations
  subjectAssessmentConfig SubjectAssessmentConfig @relation(fields: [subjectAssessmentConfigId], references: [id], onDelete: Cascade)
  scores                  ComponentScore[]

  @@unique([subjectAssessmentConfigId, name])
  @@map("subject_components")
}

// One student's score for one component (only for component-based configs)
model ComponentScore {
  id                 String @id @default(uuid())
  enrollmentId       String @map("enrollment_id")
  subjectComponentId String @map("subject_component_id")
  score              Float // 0 … SubjectComponent.maxScore

  // Relations
  enrollment       YearlyEnrollment @relation(fields: [enrollmentId], references: [id])
  subjectComponent SubjectComponent @relation(fields: [subjectComponentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([enrollmentId, subjectComponentId])
  @@index([subjectComponentId])
  @@map("component_scores")
}

// One student's total for one subject in one period: the sum of its ComponentScores, or the score
// entered directly when the config is not component-based
model MonthlySubjectScore {
  id                        String @id @default(uuid())
  enrollmentId              String @map("enrollment_id")
  subjectAssessmentConfigId String @map("subject_assessment_config_id")
  score                     Float // 0 … SubjectAssessmentConfig.maxTotalScore

  // Relations
  enrollment              YearlyEnrollment        @relation(fields: [enrollmentId], references: [id])
  subjectAssessmentConfig SubjectAssessmentConfig @relation(fields: [subjectAssessmentConfigId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([enrollmentId, subjectAssessmentConfigId])
  @@index([subjectAssessmentConfigId])
  @@map("monthly_subject_scores")
}

// A student's calculated result for one period, with their rank in their class
model MonthlyResult {
  id                 String  @id @default(uuid())
  enrollmentId       String  @map("enrollment_id")
  assessmentPeriodId String  @map("assessment_period_id")
  totalScore         Float   @map("total_score")
  average            Float
  mention            Mention
  classRank          Int     @map("class_rank") // 1 = top of the class; equal averages share a rank
  remarks            String? // teacher's comment (មតិយោបល់)

  // Relations
  enrollment       YearlyEnrollment @relation(fields: [enrollmentId], references: [id])
  assessmentPeriod AssessmentPeriod @relation(fields: [assessmentPeriodId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([enrollmentId, assessmentPeriodId])
  @@index([assessmentPeriodId])
  @@map("monthly_results")
}

// ==========================================
// 7. AUDIT LOG (append-only: the API never updates or deletes rows)
// ==========================================

// Who changed what, and when. Deliberately has no foreign keys: actor and entity are copied
// (id + readable label) so the record survives deleting the login or the changed record.
model AuditLog {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now()) @map("created_at")
  action        String // e.g. ENROLLMENT_TRANSFERRED — see src/constants/audit.ts
  entityType    String   @map("entity_type") // e.g. Enrollment
  entityId      String?  @map("entity_id") // null e.g. for a failed login with an unknown username
  entityLabel   String?  @map("entity_label") // e.g. "STU-26-0001 Sok Dara — 2026-2027"
  // null actor = seed/import script, or an anonymous login attempt
  actorUserId   String?  @map("actor_user_id")
  actorUsername String?  @map("actor_username")
  ipAddress     String?  @map("ip_address")
  // For updates only the fields that changed; never contains password hashes
  before        Json?
  after         Json?

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([action])
  @@map("audit_logs")
}
